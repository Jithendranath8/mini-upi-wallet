{
  "name": "mini-upi-wallet",
  "version": "1.0.0",
  "description": "Mini UPI Wallet - a system design showcase: idempotent payments, double-spend prevention, immutable ledger, cache, queue, read replica.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "tsx --disable-warning=ExperimentalWarning src/main.ts",
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/main.ts",
    "test": "tsx --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "race": "tsx --disable-warning=ExperimentalWarning scripts/multiprocess-race.ts",
    "loadtest": "tsx --disable-warning=ExperimentalWarning scripts/loadtest.ts",
    "crash": "tsx --disable-warning=ExperimentalWarning scripts/crash-recovery-demo.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "express": "^5.1.0",
    "marked": "^15.0.0",
    "mermaid": "^11.4.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
